<Window x:Class="WinLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLauncher" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 动态主题资源初始化 -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#252525"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="MetroBgBrush" Color="#0A0A0A"/>

        <!-- 搜索框专属动态颜色 -->
        <SolidColorBrush x:Key="SearchBoxBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SearchBoxFgBrush" Color="#111111"/>

        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="border" Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LetterBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="18"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="{DynamicResource WindowBgBrush}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" AllowDrop="True" DragOver="Window_DragOver">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnHamburger" Content="≡" FontSize="24" Width="40" Height="40" Background="Transparent"
                            Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" Click="ToggleSettingsMenu"/>
                    <TextBlock Text="开始" Foreground="{DynamicResource TextMainBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>

                    <!-- 修复：搜索框使用动态资源，随主题切换 -->
                    <TextBox x:Name="txtSearch" Width="280" Height="32" Margin="30,0,0,0"
                             Background="{DynamicResource SearchBoxBgBrush}" Foreground="{DynamicResource SearchBoxFgBrush}" 
                             BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" TextChanged="SearchBox_TextChanged" ToolTip="搜索应用"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTime" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="—" Style="{StaticResource WindowBtnStyle}" Click="Minimize_Click"/>
                    <Button x:Name="btnMaximize" Content="□" Style="{StaticResource WindowBtnStyle}" Click="Maximize_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowBtnStyle}" Click="CloseButton_Click"/>
                </StackPanel>

                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=btnHamburger}" Placement="Bottom" StaysOpen="False">
                    <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="6" BorderBrush="#555" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <TextBlock Text="界面模式" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <Button Content="Win10 模式" Width="160" Height="32" Margin="0,0,0,5" Background="#333" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" Click="SwitchToWin10"/>
                            <Button Content="Win8.1 Metro 模式" Width="160" Height="32" Background="#333" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" Click="SwitchToWin8"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="主题风格" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="深色" Width="75" Height="30" Margin="0,0,10,0" Background="#333" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" Click="SetDarkTheme_Click"/>
                                <Button Content="浅色" Width="75" Height="30" Background="#EEE" Foreground="#111" BorderThickness="0" Click="SetLightTheme_Click"/>
                            </StackPanel>
                            <TextBlock Text="Metro 背景色" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <WrapPanel Margin="5,0,0,0">
                                <Button Width="24" Height="24" Margin="0,0,6,6" Background="#004275" BorderThickness="0" Click="MetroBg_Click" Tag="#004275"/>
                                <Button Width="24" Height="24" Margin="0,0,6,6" Background="#3D2B56" BorderThickness="0" Click="MetroBg_Click" Tag="#3D2B56"/>
                                <Button Width="24" Height="24" Margin="0,0,6,6" Background="#1A3A1A" BorderThickness="0" Click="MetroBg_Click" Tag="#1A3A1A"/>
                                <Button Width="24" Height="24" Margin="0,0,6,6" Background="#5B1A1A" BorderThickness="0" Click="MetroBg_Click" Tag="#5B1A1A"/>
                                <Button Width="24" Height="24" Margin="0,0,6,6" Background="#2C2C2C" BorderThickness="0" Click="MetroBg_Click" Tag="#2C2C2C"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- 主体内容区 -->
            <Grid x:Name="gridMainContent" Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="colLeftPanel" Width="320" MinWidth="200" MaxWidth="500"/>
                    <ColumnDefinition x:Name="colSplitter" Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧面板 -->
                <Border x:Name="pnlLeft" Grid.Column="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="8" AllowDrop="True" DragOver="Window_DragOver">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="lstApps" Grid.Row="0" Grid.Column="0" ItemContainerStyle="{StaticResource AppListItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="5"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LstApps_PreviewMouseMove"
                                 MouseDoubleClick="LstApps_MouseDoubleClick">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="10,10,0,5" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="固定到任务栏" Click="PinToTaskbar_Click"/>
                                                <MenuItem Header="打开文件所在位置" Click="OpenFileLocation_Click"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Hidden" Margin="0,10,0,10">
                            <ItemsControl x:Name="letterPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LetterBtnStyle}" Content="{Binding}" Click="Letter_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 底部功能区 -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="5,10,5,10">
                            <Button Height="40" Background="Transparent" BorderThickness="0" Click="UserAccount_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <Grid Width="28" Height="28" Margin="0,0,10,0">
                                        <Ellipse x:Name="ellipseAvatarBg" Fill="#555"/>
                                        <Image x:Name="imgUserAvatar" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <TextBlock Text="当前用户" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="OpenDocuments_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="文档" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="OpenPictures_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="图片" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="OpenSettings_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="设置" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="PowerButton_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="电源" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter x:Name="gridSplitter" Grid.Column="1" Style="{StaticResource SplitterStyle}"/>

                <!-- 右侧磁贴区域（Win10 模式） -->
                <Border x:Name="pnlRight10" Grid.Column="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="8" AllowDrop="True" DragOver="Window_DragOver">
                    <ScrollViewer x:Name="scrollWin10" VerticalScrollBarVisibility="Auto" Padding="15" AllowDrop="True" DragOver="Window_DragOver">
                        <StackPanel AllowDrop="True" DragOver="Window_DragOver">
                            <TextBlock Text="固定到开始屏幕" Foreground="{DynamicResource TextMainBrush}" FontSize="16" FontWeight="SemiBold" Margin="5,0,0,10"/>
                            <ItemsControl x:Name="tileGroupsControl" Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10" AllowDrop="True" DragOver="Window_DragOver">
                                            <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="5,0,0,5" MouseLeftButtonDown="GroupTitle_MouseLeftButtonDown"/>
                                            <ItemsControl ItemsSource="{Binding Tiles}" Height="{Binding GroupHeight}" 
                                                          AllowDrop="True" DragOver="Window_DragOver" Drop="Group_Drop">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Background="Transparent" AllowDrop="True" DragOver="Window_DragOver"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding TileColor}" CornerRadius="6" AllowDrop="True" DragOver="Window_DragOver">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="以管理员身份运行" Click="RunAsAdmin_Click"/>
                                                                    <MenuItem Header="打开文件所在位置" Click="OpenFileLocation_Click"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="小图" Click="SetTileSizeSmall"/>
                                                                    <MenuItem Header="中图" Click="SetTileSizeMedium"/>
                                                                    <MenuItem Header="宽图" Click="SetTileSizeWide"/>
                                                                    <MenuItem Header="大图" Click="SetTileSizeLarge"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="取消固定" Click="UnpinTile"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>

                                                            <Grid PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" PreviewMouseMove="Tile_PreviewMouseMove" Background="Transparent">
                                                                <Button Background="Transparent" BorderThickness="0" Click="TileClick">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                                                        <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,0,5"/>
                                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="90" TextAlignment="Center" Foreground="White" FontSize="12"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="50" Margin="5,10" Background="Transparent" BorderBrush="#444" BorderThickness="1" CornerRadius="6"
                                    AllowDrop="True" DragOver="Window_DragOver" Drop="NewGroup_Drop">
                                <TextBlock Text="+ 拖拽到此处新建磁贴分组" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Metro 全屏模式 -->
                <Border x:Name="pnlRight8" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource MetroBgBrush}" CornerRadius="8" Visibility="Collapsed" AllowDrop="True" DragOver="Window_DragOver">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,0,0">
                            <Button Background="Transparent" BorderThickness="0" Click="MetroUserMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="36" Height="36" Margin="0,0,15,0">
                                        <Ellipse x:Name="ellipseMetroAvatarBg" Fill="#555"/>
                                        <Image x:Name="imgMetroAvatar" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <TextBlock x:Name="txtMetroUserName" Text="管理员" Foreground="White" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer x:Name="scrollWin8" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
                            <ItemsControl x:Name="metroTileControl" Margin="40,20,20,40">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding TileColor}" CornerRadius="0" Margin="4" AllowDrop="True" DragOver="Window_DragOver">
                                            <Button Background="Transparent" BorderThickness="0" Click="TileClick">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                                    <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="90" TextAlignment="Center" Foreground="White" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15">
                            <Button x:Name="btnDownArrow" Width="40" Height="40" Background="Transparent" BorderThickness="0" Click="ToggleAppsView">
                                <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="20"/>
                            </Button>
                        </StackPanel>

                        <Grid x:Name="pnlAllAppsView" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource MetroBgBrush}" Visibility="Collapsed" Margin="20,10,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                <Button x:Name="btnUpArrow" Width="40" Height="40" Background="Transparent" BorderThickness="0" Click="ToggleAppsView">
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="20"/>
                                </Button>
                                <TextBlock Text="所有应用" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="allAppsMetroControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="180" Height="60" Background="Transparent" BorderThickness="0" Click="TileClick" HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,15,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>