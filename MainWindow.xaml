<Window x:Class="WinLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLauncher" Height="680" Width="680" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Transparent"
        AllowsTransparency="False" ResizeMode="CanResize"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" DragLeave="Window_DragLeave" GiveFeedback="Window_GiveFeedback" KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ===== 颜色资源（代码里会动态改写，皮肤/主题都走这里） ===== -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#0A000000"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#1E000000"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAFFFFFF"/>
        <SolidColorBrush x:Key="MetroBgBrush" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="SearchBoxBgBrush" Color="#3CFFFFFF"/>
        <SolidColorBrush x:Key="SearchBoxFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#DCFFFFFF"/>
        <SolidColorBrush x:Key="ButtonFgBrush" Color="#000000"/>
        <CornerRadius x:Key="TileCornerRadius">0</CornerRadius>

        <!-- ===== 深色右键菜单 ===== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFF0F0F0"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Opened">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFF0F0F0"/>
            <Setter Property="Padding" Value="10,6,20,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 线性图标：全部用 Path 几何绘制，不依赖 Segoe MDL2 / Segoe Fluent Icons，Win7/8 也能正常显示 -->
        <Style x:Key="LineIconStyle" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 外壳：窗口按钮 ===== -->
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Microsoft YaHei UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 外壳：关闭按钮（悬停变红，跟原版一致） ===== -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Microsoft YaHei UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 外壳：左侧菜单按钮（≡，打开五种模式切换） ===== -->
        <Style x:Key="HamburgerStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 设置弹层按钮 ===== -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 应用列表项（Win10 / Win11） ===== -->
        <Style x:Key="AppListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 应用列表项（XP 经典：扁平、无圆角） ===== -->
        <Style x:Key="XPListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF316AC5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF316AC5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 应用列表项（Win7：白底浅蓝悬停、无圆角） ===== -->
        <Style x:Key="Win7ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFCBE3F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFB7D8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== XP 右栏链接 ===== -->
        <Style x:Key="XPLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF0A246A"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft YaHei UI, SimSun"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40316AC5"/>
                                <Setter Property="Foreground" Value="#FF0A246A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Win7 右栏链接（深蓝底白字） ===== -->
        <Style x:Key="Win7LinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Win10 左侧图标条按钮 ===== -->
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Win11 固定区图标 ===== -->
        <Style x:Key="Win11ItemStyle" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== XP 关机按钮 ===== -->
        <Style x:Key="XPPowerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="86"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft YaHei UI, SimSun"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3" BorderThickness="1" BorderBrush="#FF0A246A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF4C9BEF" Offset="0"/>
                                    <GradientStop Color="#FF1B62C8" Offset="0.55"/>
                                    <GradientStop Color="#FF0A4DB0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFB84D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Win7 关机按钮 ===== -->
        <Style x:Key="Win7PowerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="Foreground" Value="#FF12395C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="1" BorderBrush="#FFA0B8CF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFE2ECF6" Offset="0.5"/>
                                    <GradientStop Color="#FFC4D7E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4C9BEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ============ 根容器 ============ -->
    <Grid>
        <Border x:Name="MainBorder" Background="{DynamicResource WindowBgBrush}" CornerRadius="8"
                BorderBrush="#3AFFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="rowShell" Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== 外壳顶栏：≡ 菜单 / 模式名 / 时钟 / 最小化 最大化 关闭 ===== -->
                <Border x:Name="pnlShell" Grid.Row="0" Panel.ZIndex="10"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                    <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="btnHamburger" Content="&#x2261;" Style="{StaticResource HamburgerStyle}"
                                    Click="ToggleSettingsMenu" ToolTip="菜单与设置（切换五种开始菜单）"/>
                            <TextBlock x:Name="txtShellTitle" Text="WinLauncher" Foreground="{DynamicResource TextMainBrush}"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="txtTime" Foreground="{DynamicResource TextMainBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.85"/>
                            <Button Content="&#x2500;" Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click" ToolTip="最小化"/>
                            <Button x:Name="btnMaximize" Content="&#x25A1;" Style="{StaticResource ChromeButtonStyle}" Click="Maximize_Click" ToolTip="最大化 / 还原"/>
                            <Button Content="&#x2715;" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="关闭"/>
                        </StackPanel>
                    <!-- ===== 设置弹层 ===== -->
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=btnHamburger}" Placement="Bottom" StaysOpen="False">
                        <Border Background="#F0181818" CornerRadius="8" BorderBrush="#44FFFFFF" BorderThickness="1" Padding="12">
                            <StackPanel Width="200">
                                <TextBlock Text="开始菜单样式" Foreground="White" FontSize="11" Margin="4,0,0,4" Opacity="0.7"/>
                                <Button Content="Windows XP" Height="28" Style="{StaticResource MenuButtonStyle}" Click="SwitchToXP"/>
                                <Button Content="Windows 7" Height="28" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin7"/>
                                <Button Content="Windows 8" Height="28" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin8"/>
                                <Button Content="Windows 10" Height="28" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin10"/>
                                <Button Content="Windows 11" Height="28" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin11"/>

                                <Separator Margin="0,8"/>
                                <TextBlock Text="深浅主题（XP/7 固定浅色）" Foreground="White" FontSize="11" Margin="4,0,0,4" Opacity="0.7"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Content="深色" Width="96" Height="28" Style="{StaticResource MenuButtonStyle}" Margin="0,0,8,0" Click="SetDarkTheme_Click"/>
                                    <Button Content="浅色" Width="96" Height="28" Style="{StaticResource MenuButtonStyle}" Click="SetLightTheme_Click"/>
                                </StackPanel>

                                <TextBlock Text="Win8 背景色" Foreground="White" FontSize="11" Margin="4,6,0,4" Opacity="0.7"/>
                                <WrapPanel>
                                    <Button Width="24" Height="24" Margin="0,0,6,0" Background="#0A0A0A" BorderThickness="0" Click="MetroBg_Click" Tag="#0A0A0A"/>
                                    <Button Width="24" Height="24" Margin="0,0,6,0" Background="#004275" BorderThickness="0" Click="MetroBg_Click" Tag="#004275"/>
                                    <Button Width="24" Height="24" Margin="0,0,6,0" Background="#3D2B56" BorderThickness="0" Click="MetroBg_Click" Tag="#3D2B56"/>
                                    <Button Width="24" Height="24" Margin="0,0,6,0" Background="#1A3A1A" BorderThickness="0" Click="MetroBg_Click" Tag="#1A3A1A"/>
                                    <Button Width="24" Height="24" Background="#5B1A1A" BorderThickness="0" Click="MetroBg_Click" Tag="#5B1A1A"/>
                                </WrapPanel>

                                <Separator Margin="0,8"/>
                                <TextBlock Text="已导入皮肤（右键删除）" Foreground="White" FontSize="11" Margin="4,0,0,4" Opacity="0.7"/>
                                <ItemsControl x:Name="skinListControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding SkinName}" Height="28" Style="{StaticResource MenuButtonStyle}" Click="ApplySkin_Click" Tag="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="删除该皮肤" Click="DeleteSkin_Click" Tag="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ 导入皮肤 JSON" Height="28" Style="{StaticResource MenuButtonStyle}" Background="#0078D7" Foreground="White" Click="ImportSkin_Click"/>

                                <Separator Margin="0,8"/>
                                <TextBlock Text="{DynamicResource L.Language}" Foreground="White" FontSize="11" Margin="4,0,0,4" Opacity="0.7"/>
                                <ItemsControl x:Name="languageListControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}" Height="28" Style="{StaticResource MenuButtonStyle}"
                                                    Click="SwitchLanguage_Click" Tag="{Binding Code}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="导入旧配置" Height="28" Style="{StaticResource MenuButtonStyle}" Background="#28A745" Foreground="White" Click="ImportConfig_Click"/>
                                <Button Content="导出当前配置" Height="28" Style="{StaticResource MenuButtonStyle}" Background="#17A2B8" Foreground="White" Click="ExportConfig_Click"/>
                                <Button Content="一键还原（清空配置）" Height="28" Style="{StaticResource MenuButtonStyle}" Background="#DC3545" Foreground="White" Click="ResetConfig_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    </Grid>
                </Border>

                <!-- ===== 内容区：五种模式各自独立 ===== -->
                <Grid x:Name="gridMainContent" Grid.Row="1" Margin="0">
                    <Canvas x:Name="dragLayer" IsHitTestVisible="False" Panel.ZIndex="999"/>

                    <!-- ============================================================ -->
                    <!-- ① WINDOWS XP 经典开始菜单                                     -->
                    <!-- ============================================================ -->
                    <Border x:Name="pnlXP" Width="396" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="3" BorderThickness="1" BorderBrush="#FF0831D9" Visibility="Collapsed"
                            TextElement.FontFamily="Tahoma, Microsoft YaHei UI, SimSun">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0A2C86" Offset="0"/>
                                <GradientStop Color="#FF1F62D0" Offset="0.5"/>
                                <GradientStop Color="#FF0A2C86" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="54"/>
                            </Grid.RowDefinitions>

                            <!-- XP 标题条 -->
                            <Border Grid.Row="0" CornerRadius="2,2,0,0" BorderThickness="0,0,0,1" BorderBrush="#FF0A246A">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF0058E6" Offset="0"/>
                                        <GradientStop Color="#FF3A93FF" Offset="0.5"/>
                                        <GradientStop Color="#FF0A4DB0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border Width="26" Height="26" CornerRadius="2" Background="#FF2A5FBF" BorderBrush="#FFFFD98A" BorderThickness="1" Margin="0,0,8,0">
                                        <Grid>
                                            <Ellipse x:Name="ellipseXpAvatarBg" Fill="#FF3F6FB5" Margin="2"/>
                                            <Image x:Name="imgXpAvatar" Stretch="UniformToFill" Margin="2">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="11,11" RadiusX="11" RadiusY="11"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="txtXpUserName" Text="管理员" Foreground="White" FontSize="12.5" FontWeight="Bold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                </StackPanel>
                            </Border>

                            <!-- XP 双栏 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="202"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左栏：白色程序区 -->
                                <Border Grid.Column="0" Background="#FFFFFFFF" BorderThickness="0,0,1,0" BorderBrush="#FF9DB9EB">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{DynamicResource L.PinnedHeader}" Foreground="#FF7A7A7A" FontSize="10.5" Margin="10,8,0,4"/>
                                        <ListBox x:Name="lstAppsXP" Grid.Row="1" ItemContainerStyle="{StaticResource XPListItemStyle}"
                                                 Background="Transparent" BorderThickness="0" Padding="4,0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.PanningMode="VerticalOnly"
                                                 PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="LstApps_PreviewMouseMove"
                                                 PreviewTouchDown="LstApps_PreviewTouchDown"
                                                 PreviewTouchUp="LstApps_PreviewTouchUp"
                                                 PreviewTouchMove="LstApps_PreviewTouchMove"
                                                 MouseDoubleClick="LstApps_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource L.PinTaskbar}" Click="PinToTaskbar_Click"/>
                                                            <MenuItem Header="{DynamicResource L.OpenLocation}" Click="OpenFileLocation_Click"/>
                                                            <MenuItem Header="{DynamicResource L.RunAsAdmin}" Click="RunAsAdmin_Click"/>
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                                        <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="2" Height="1" Background="#FFD6DFF0" Margin="8,4,8,4"/>
                                        <Button Grid.Row="3" x:Name="btnXpAllPrograms" Height="26" Margin="4,0,4,6" Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Left" Cursor="Hand" Click="OpenAllProgramsFolder">
                                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                                <TextBlock Text="所有程序" Foreground="#FF000000" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#x25B8;" Foreground="#FF1E7B1E" FontSize="11" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 右栏：浅蓝系统链接 -->
                                <Border Grid.Column="1" Background="#FFD3E5FA">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6,0,6">
                                        <StackPanel>
                                            <Button Content="我的文档" Style="{StaticResource XPLinkStyle}" Click="OpenDocuments_Click"/>
                                            <Button Content="我的图片" Style="{StaticResource XPLinkStyle}" Click="OpenPictures_Click"/>
                                            <Button Content="我的音乐" Style="{StaticResource XPLinkStyle}" Click="OpenMusic_Click"/>
                                            <Button Content="我的电脑" Style="{StaticResource XPLinkStyle}" Click="OpenComputer_Click"/>
                                            <Border Height="1" Background="#FFA8C4E8" Margin="8,5,8,5"/>
                                            <Button Content="{DynamicResource L.ControlPanel}" Style="{StaticResource XPLinkStyle}" Click="OpenSettings_Click"/>
                                            <Button Content="打印机和传真" Style="{StaticResource XPLinkStyle}" Click="OpenDevices_Click"/>
                                            <Button Content="{DynamicResource L.Help}" Style="{StaticResource XPLinkStyle}" Click="OpenHelp_Click"/>
                                            <Button Content="搜索" Style="{StaticResource XPLinkStyle}" Click="OpenSearchBox"/>
                                            <Button Content="{DynamicResource L.Run}" Style="{StaticResource XPLinkStyle}" Click="OpenRunDialog"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- XP 底部：橙色分隔 + 注销/关机 -->
                            <Border Grid.Row="2" BorderThickness="0,2,0,0" BorderBrush="#FFE8A200">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFF9A1E" Offset="0"/>
                                        <GradientStop Color="#FFE07B12" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Button Content="{DynamicResource L.SignOut}" Style="{StaticResource XPPowerButtonStyle}" Click="XpLogOff_Click"/>
                                    <Button Content="{DynamicResource L.ShutDown}" Width="92" Style="{StaticResource XPPowerButtonStyle}" Click="XpShutdown_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============================================================ -->
                    <!-- ② WINDOWS 7 AERO 开始菜单                                    -->
                    <!-- ============================================================ -->
                    <Border x:Name="pnlWin7" Width="560" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="8" BorderThickness="1" BorderBrush="#55FFFFFF" Visibility="Collapsed"
                            Background="#FF2E2E2E" TextElement.FontFamily="Microsoft YaHei UI, Tahoma">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="54"/>
                            </Grid.RowDefinitions>

                            <!-- Win7 顶部：深蓝玻璃条 + 头像 -->
                            <Border Grid.Row="0" CornerRadius="7,7,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF444444" Offset="0"/>
                                        <GradientStop Color="#FF333333" Offset="0.55"/>
                                        <GradientStop Color="#FF262626" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Border Width="46" Height="46" CornerRadius="2" Background="#FF2A4A70" BorderBrush="#88FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Ellipse x:Name="ellipseWin7AvatarBg" Fill="#FF3E6288" Margin="2"/>
                                            <Image x:Name="imgWin7Avatar" Stretch="UniformToFill" Margin="2">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="21,21" RadiusX="21" RadiusY="21"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="txtWin7UserName" Text="管理员" Foreground="#FFFFFFFF" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Win7 主体：左白右深蓝 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左栏：白色程序区 + 所有程序 -->
                                <Border Grid.Column="0" Background="#FFFFFFFF">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="lstAppsWin7" ItemContainerStyle="{StaticResource Win7ListItemStyle}"
                                                 Background="Transparent" BorderThickness="0" Padding="4"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.PanningMode="VerticalOnly"
                                                 PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="LstApps_PreviewMouseMove"
                                                 PreviewTouchDown="LstApps_PreviewTouchDown"
                                                 PreviewTouchUp="LstApps_PreviewTouchUp"
                                                 PreviewTouchMove="LstApps_PreviewTouchMove"
                                                 MouseDoubleClick="LstApps_MouseDoubleClick">
                                            <ListBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" Foreground="#FF7C8FA6" FontSize="11" Margin="8,8,0,3" FontWeight="Bold"/>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{DynamicResource L.PinTaskbar}" Click="PinToTaskbar_Click"/>
                                                                <MenuItem Header="{DynamicResource L.OpenLocation}" Click="OpenFileLocation_Click"/>
                                                            <MenuItem Header="{DynamicResource L.RunAsAdmin}" Click="RunAsAdmin_Click"/>
                                                            </ContextMenu>
                                                        </StackPanel.ContextMenu>
                                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,9,0"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="#FF1B3A5C" FontSize="12.5" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Button Grid.Row="1" Height="32" Margin="0,0,0,0" Background="Transparent" BorderThickness="0,1,0,0"
                                                BorderBrush="#FFDCE6F0" HorizontalContentAlignment="Left" Cursor="Hand" Click="OpenAllProgramsFolder">
                                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#FF1E6B2E" Margin="0,0,8,0">
                                                    <Path Style="{StaticResource LineIconStyle}" Width="8" Height="8" Stroke="White"
                                                          Data="M2,5 L6,10 L10,5" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Text="所有程序" Foreground="#FF1B3A5C" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 右栏：深蓝玻璃 + 白色链接 -->
                                <Border Grid.Column="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3A3A3A" Offset="0"/>
                                            <GradientStop Color="#FF242424" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,10,8,10">
                                        <StackPanel>
                                            <Button Content="{DynamicResource L.Documents}" Style="{StaticResource Win7LinkStyle}" Click="OpenDocuments_Click"/>
                                            <Button Content="{DynamicResource L.Pictures}" Style="{StaticResource Win7LinkStyle}" Click="OpenPictures_Click"/>
                                            <Button Content="{DynamicResource L.Music}" Style="{StaticResource Win7LinkStyle}" Click="OpenMusic_Click"/>
                                            <Button Content="{DynamicResource L.Computer}" Style="{StaticResource Win7LinkStyle}" Click="OpenComputer_Click"/>
                                            <Border Height="1" Background="#33FFFFFF" Margin="10,6,10,6"/>
                                            <Button Content="{DynamicResource L.ControlPanel}" Style="{StaticResource Win7LinkStyle}" Click="OpenSettings_Click"/>
                                            <Button Content="{DynamicResource L.Devices}" Style="{StaticResource Win7LinkStyle}" Click="OpenDevices_Click"/>
                                            <Button Content="{DynamicResource L.DefaultPrograms}" Style="{StaticResource Win7LinkStyle}" Click="OpenDefaultPrograms_Click"/>
                                            <Button Content="{DynamicResource L.Help}" Style="{StaticResource Win7LinkStyle}" Click="OpenHelp_Click"/>
                                            <Button Content="{DynamicResource L.Run}" Style="{StaticResource Win7LinkStyle}" Click="OpenRunDialog"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- Win7 底部：搜索框（白）+ 关机 -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FFFFFFFF" Padding="0">
                                    <Border Height="30" Margin="10,10,10,10" CornerRadius="3" Background="White"
                                            BorderBrush="#FF8EA9C4" BorderThickness="1" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBox x:Name="txtSearchWin7" Background="Transparent" BorderThickness="0" Foreground="#FF1B3A5C"
                                                     FontSize="12" VerticalContentAlignment="Center" Padding="6,0" TextChanged="SearchBox_TextChanged"/>
                                            <TextBlock x:Name="phSearchWin7" Text="{DynamicResource L.SearchPrograms}" Foreground="#FF8FA6BD" FontSize="12" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </Border>
                                <Border Grid.Column="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF3A3A3A" Offset="0"/>
                                            <GradientStop Color="#FF242424" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Button Content="{DynamicResource L.PowerOff}" Style="{StaticResource Win7PowerButtonStyle}" Click="PowerButton_Click"/>
                                        <Button Content="&#x25B8;" Width="22" Height="30" Margin="2,0,0,0" FontSize="10"
                                                Background="Transparent" BorderThickness="0" Foreground="#FFFFFFFF" Cursor="Hand" Click="PowerButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============================================================ -->
                    <!-- ③ WINDOWS 8 / 8.1 全屏开始屏幕                                -->
                    <!-- ============================================================ -->
                    <Border x:Name="pnlRight8" Background="{DynamicResource MetroBgBrush}" Visibility="Collapsed"
                            AllowDrop="True" DragOver="Window_DragOver" TextElement.FontFamily="Microsoft YaHei UI, Tahoma">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image x:Name="imgWin8Backdrop" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="0.42" IsHitTestVisible="False"/>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="36,18,0,0">
                                <Button Background="Transparent" BorderThickness="0" Click="MetroUserMenu_Click" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="36" Height="36" Margin="0,0,14,0">
                                            <Ellipse x:Name="ellipseMetroAvatarBg" Fill="#555"/>
                                            <Image x:Name="imgMetroAvatar" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                        <TextBlock x:Name="txtMetroUserName" Text="管理员" Foreground="White" FontSize="15"
                                                   VerticalAlignment="Center" FontWeight="Light"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ScrollViewer x:Name="scrollWin8" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly" PanningDeceleration="0.002">
                                <ItemsControl x:Name="metroTileControl" Margin="36,24,36,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding TileColor}" CornerRadius="{DynamicResource TileCornerRadius}" Margin="3" Tag="tile">
                                                <Grid PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" PreviewMouseMove="Tile_PreviewMouseMove"
                                                      PreviewTouchDown="Tile_PreviewTouchDown" PreviewTouchUp="Tile_PreviewTouchUp"
                                                      PreviewTouchMove="Tile_PreviewTouchMove" Background="Transparent">
                                                    <Button Background="Transparent" BorderThickness="0" Click="TileClick">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                                            <Image Source="{Binding Icon}" Width="34" Height="34" Margin="0,0,0,6"/>
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="100" TextAlignment="Center"
                                                                       Foreground="White" FontSize="12.5" FontWeight="Light"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Button x:Name="btnDownArrow" Width="52" Height="52" Click="ToggleAppsView" Cursor="Hand" ToolTip="所有应用">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="26">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#66FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Path Style="{StaticResource LineIconStyle}" Width="22" Height="22" Stroke="White"
                                          Data="M10,3 V16 M4,9.5 L10,16 L16,9.5"/>
                                </Button>
                            </StackPanel>

                            <!-- 所有应用 -->
                            <Grid x:Name="pnlAllAppsView" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource MetroBgBrush}"
                                  Visibility="Collapsed" Margin="30,14,30,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                    <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Click="ToggleAppsView" Cursor="Hand">
                                                                                <Path Style="{StaticResource LineIconStyle}" Width="20" Height="20" Stroke="White" Data="M12,4 L6,10 L12,16"/>
                                    </Button>
                                    <TextBlock Text="所有应用" Foreground="White" FontSize="21" FontWeight="Light" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="allAppsMetroControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="190" Height="54" Background="Transparent" BorderThickness="0" Click="TileClick"
                                                        HorizontalContentAlignment="Left" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" Margin="4">
                                                        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13.5" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============================================================ -->
                    <!-- ④ WINDOWS 10 开始菜单                                        -->
                    <!-- ============================================================ -->
                    <Border x:Name="pnlWin10Root" Width="640" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" TextElement.FontFamily="Microsoft YaHei UI, Tahoma">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition x:Name="colLeftPanel" Width="272"/>
                                <ColumnDefinition x:Name="colSplitter" Width="0"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标条 -->
                            <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}">
                                <StackPanel x:Name="pnlWin10Buttons" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                    <Button Style="{StaticResource RailButtonStyle}" Click="UserAccount_Click" ToolTip="账户">
                                        <Grid Width="26" Height="26">
                                            <Ellipse x:Name="ellipseAvatarBg" Fill="#55FFFFFF"/>
                                            <Image x:Name="imgUserAvatar" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource RailButtonStyle}" Click="OpenDocuments_Click" ToolTip="文档">
                                                                                <Path Style="{StaticResource LineIconStyle}" Width="18" Height="18" Stroke="{DynamicResource TextMainBrush}" Data="M5,2 H12 L16,6 V18 H5 Z M12,2 V6 H16"/>
                                    </Button>
                                    <Button Style="{StaticResource RailButtonStyle}" Click="OpenPictures_Click" ToolTip="图片">
                                                                                <Path Style="{StaticResource LineIconStyle}" Width="18" Height="18" Stroke="{DynamicResource TextMainBrush}" Data="M2,3 H18 V17 H2 Z M5,14 L9,8 L12,12 L14,10 L17,14 M6.4,6.4 A1.4,1.4 0 1 1 6.39,6.4"/>
                                    </Button>
                                    <Button Style="{StaticResource RailButtonStyle}" Click="OpenSettings_Click" ToolTip="设置">
                                                                                <Path Style="{StaticResource LineIconStyle}" Width="18" Height="18" Stroke="{DynamicResource TextMainBrush}" Data="M10,5.5 A4.5,4.5 0 1 1 9.99,5.5 M10,1.5 V3.5 M10,16.5 V18.5 M1.5,10 H3.5 M16.5,10 H18.5 M4,4 L5.4,5.4 M14.6,14.6 L16,16 M16,4 L14.6,5.4 M5.4,14.6 L4,16"/>
                                    </Button>
                                    <Button Style="{StaticResource RailButtonStyle}" Click="PowerButton_Click" ToolTip="电源">
                                                                                <Path Style="{StaticResource LineIconStyle}" Width="18" Height="18" Stroke="{DynamicResource TextMainBrush}" Data="M10,2 V8.5 M5.5,5.5 A6.6,6.6 0 1 0 14.5,5.5"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 应用列表 -->
                            <Border x:Name="pnlLeft" Grid.Column="1" Background="{DynamicResource PanelBgBrush}" AllowDrop="True" DragOver="Window_DragOver">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.ColumnSpan="2" Height="30" Margin="12,12,12,6" CornerRadius="3"
                                            Background="{DynamicResource SearchBoxBgBrush}">
                                        <Grid>
                                            <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource SearchBoxFgBrush}" FontSize="12"
                                                     VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged"/>
                                            <TextBlock x:Name="phSearch" Text="{DynamicResource L.Search}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="lstApps" Grid.Row="1" Grid.Column="0" ItemContainerStyle="{StaticResource AppListItemStyle}"
                                             Background="Transparent" BorderThickness="0" Padding="6,0,0,6"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.PanningMode="VerticalOnly"
                                             PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="LstApps_PreviewMouseMove"
                                             PreviewTouchDown="LstApps_PreviewTouchDown"
                                             PreviewTouchUp="LstApps_PreviewTouchUp"
                                             PreviewTouchMove="LstApps_PreviewTouchMove"
                                             MouseDoubleClick="LstApps_MouseDoubleClick">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                                                                   Margin="8,10,0,4" FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource L.PinTaskbar}" Click="PinToTaskbar_Click"/>
                                                            <MenuItem Header="{DynamicResource L.OpenLocation}" Click="OpenFileLocation_Click"/>
                                                            <MenuItem Header="{DynamicResource L.RunAsAdmin}" Click="RunAsAdmin_Click"/>
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                                    <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}" FontSize="13"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Hidden" Margin="0,10,2,10">
                                        <ItemsControl x:Name="letterPanel">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Height="16" Width="18"
                                                            Click="Letter_Click"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <GridSplitter x:Name="gridSplitter" Grid.Column="2" Width="0" Background="Transparent" Visibility="Collapsed"/>

                            <!-- 磁贴区 -->
                            <Border x:Name="pnlRight10" Grid.Column="3" Background="{DynamicResource PanelBgBrush}" AllowDrop="True" DragOver="Window_DragOver">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                <ScrollViewer x:Name="scrollWin10" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="4,10,4,10"
                                              AllowDrop="True" DragOver="Window_DragOver" PanningMode="VerticalOnly">
                                    <StackPanel AllowDrop="True" DragOver="Window_DragOver">
                                        <TextBlock Text="{DynamicResource L.PinnedToStart}" Foreground="{DynamicResource TextMainBrush}" FontSize="14"
                                                   FontWeight="SemiBold" Margin="4,0,0,10"/>
                                        <StackPanel x:Name="tileContainerPanel">
                                            <ItemsControl x:Name="tileGroupsControl" Margin="0,0,0,18">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,10" AllowDrop="True" DragOver="Window_DragOver" Drop="GroupReorder_Drop">
                                                            <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                                                                       Margin="4,0,0,5" MouseLeftButtonDown="GroupTitle_MouseLeftButtonDown"
                                                                       PreviewMouseLeftButtonDown="GroupTitle_PreviewMouseLeftButtonDown"
                                                                       PreviewMouseMove="GroupTitle_PreviewMouseMove">
                                                                <TextBlock.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="{DynamicResource L.RenameGroup}" Click="RenameGroup_Click"/>
                                                                        <MenuItem Header="{DynamicResource L.DeleteGroup}" Click="DeleteGroup_Click"/>
                                                                    </ContextMenu>
                                                                </TextBlock.ContextMenu>
                                                            </TextBlock>
                                                            <ItemsControl ItemsSource="{Binding Tiles}" Height="{Binding GroupHeight}"
                                                                          AllowDrop="True" DragOver="Group_DragOver" Drop="Group_Drop">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas Background="Transparent" AllowDrop="True"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Left" Value="{Binding DisplayX}"/>
                                                                        <Setter Property="Canvas.Top" Value="{Binding DisplayY}"/>
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding TileColor}" CornerRadius="{DynamicResource TileCornerRadius}" AllowDrop="True" Tag="tile" RenderTransformOrigin="0.5,0.5">

                                                                            <Border.ContextMenu>
                                                                                <ContextMenu>
                                                                                    <MenuItem Header="{DynamicResource L.CustomColor}" Click="ChangeTileColor_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{DynamicResource L.Small}" Click="SetTileSizeSmall"/>
                                                                                    <MenuItem Header="{DynamicResource L.Medium}" Click="SetTileSizeMedium"/>
                                                                                    <MenuItem Header="{DynamicResource L.Wide}" Click="SetTileSizeWide"/>
                                                                                    <MenuItem Header="{DynamicResource L.Large}" Click="SetTileSizeLarge"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{DynamicResource L.OpenLocation}" Click="OpenFileLocation_Click"/>
                                                                                    <MenuItem Header="{DynamicResource L.RunAsAdmin}" Click="RunAsAdmin_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{DynamicResource L.Unpin}" Click="UnpinTile"/>
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <Grid PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" PreviewMouseMove="Tile_PreviewMouseMove"
                                                                                  PreviewTouchDown="Tile_PreviewTouchDown" PreviewTouchUp="Tile_PreviewTouchUp"
                                                                                  PreviewTouchMove="Tile_PreviewTouchMove" Background="Transparent">
                                                                                <Button Background="Transparent" BorderThickness="0" Click="TileClick">
                                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                                                                        <Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,0,5"/>
                                                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="92"
                                                                                                   TextAlignment="Center" Foreground="White" FontSize="11.5"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                    <!-- 固定在底部的投放区：不随分组高度移动，拖到这里一定新建分组 -->
                                    <Border Grid.Row="1" Height="52" Margin="10,4,10,10" Background="#1AFFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1"
                                            CornerRadius="{DynamicResource TileCornerRadius}" AllowDrop="True" DragOver="Window_DragOver" Drop="NewGroup_Drop">
                                        <TextBlock Text="{DynamicResource L.NewGroupHint}" Foreground="{DynamicResource TextMainBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============================================================ -->
                    <!-- ⑤ WINDOWS 11 开始菜单                                        -->
                    <!-- ============================================================ -->
                    <Border x:Name="pnlWin11" Width="620" Height="700" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="8" BorderThickness="1" BorderBrush="#22FFFFFF" Visibility="Collapsed"
                            Background="{DynamicResource PanelBgBrush}" TextElement.FontFamily="Microsoft YaHei UI, Tahoma">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 搜索框 -->
                            <Border Grid.Row="0" Height="34" Margin="40,24,40,14" CornerRadius="4"
                                    Background="{DynamicResource SearchBoxBgBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Grid>
                                    <TextBox x:Name="txtSearchWin11" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource SearchBoxFgBrush}" FontSize="12.5"
                                             VerticalContentAlignment="Center" Padding="30,0,8,0" TextChanged="SearchBox_TextChanged"/>
                                    <TextBlock x:Name="phSearchWin11" Text="{DynamicResource L.SearchTip}" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12.5" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                                        <Path Style="{StaticResource LineIconStyle}" Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}" Data="M8.5,3 A5.5,5.5 0 1 1 8.49,3 M12.4,12.4 L17,17" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 已固定 -->
                            <Grid Grid.Row="1" Margin="40,0,40,6">
                                <TextBlock Text="{DynamicResource L.Pinned}" Foreground="{DynamicResource TextMainBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="btnWin11Expand" Content="{DynamicResource L.ShowAll}" HorizontalAlignment="Right" Background="{DynamicResource ButtonBgBrush}"
                                        Foreground="{DynamicResource ButtonFgBrush}" FontSize="11" Height="24" Padding="10,0"
                                        BorderThickness="0" Cursor="Hand" Click="ToggleWin11AllApps"/>
                            </Grid>

                            <!-- 固定应用网格 -->
                            <ScrollViewer x:Name="scrollWin11Pinned" Grid.Row="2" MaxHeight="184" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <WrapPanel x:Name="win11AppsGrid" Background="Transparent" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
                                           HorizontalAlignment="Center"/>
                            </ScrollViewer>

                            <!-- 全部（按首字母分组） -->
                            <Grid Grid.Row="3" Margin="40,4,40,62" ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource L.All}" Foreground="{DynamicResource TextMainBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="lstAppsWin11" ItemContainerStyle="{StaticResource AppListItemStyle}"
                                             Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.PanningMode="VerticalOnly"
                                             PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="LstApps_PreviewMouseMove"
                                             PreviewTouchDown="LstApps_PreviewTouchDown"
                                             PreviewTouchUp="LstApps_PreviewTouchUp"
                                             PreviewTouchMove="LstApps_PreviewTouchMove"
                                             MouseDoubleClick="LstApps_MouseDoubleClick">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                                   Margin="2,8,0,3" FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource L.PinTaskbar}" Click="PinToTaskbar_Click"/>
                                                            <MenuItem Header="{DynamicResource L.OpenLocation}" Click="OpenFileLocation_Click"/>
                                                            <MenuItem Header="{DynamicResource L.RunAsAdmin}" Click="RunAsAdmin_Click"/>
                                                        </ContextMenu>
                                                    </StackPanel.ContextMenu>
                                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,9,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}" FontSize="12"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" Margin="0,4,0,4">
                                        <ItemsControl x:Name="letterPanelWin11">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Height="15" Width="18"
                                                            Click="LetterWin11_Click"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <!-- 底部：账户 + 系统入口 -->
                            <Grid Grid.Row="0" Grid.RowSpan="5" Height="56" Margin="40,0,40,10" VerticalAlignment="Bottom" Panel.ZIndex="5">
                                <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="UserAccount_Click" Cursor="Hand" Padding="6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#44FFFFFF" Margin="0,0,9,0">
                                            <Grid>
                                                <Ellipse x:Name="ellipseWin11AvatarBg" Fill="#55FFFFFF"/>
                                                <Image x:Name="imgWin11Avatar" Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="13,13" RadiusX="13" RadiusY="13"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="txtWin11UserName" Text="管理员" Foreground="{DynamicResource TextMainBrush}"
                                                   FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Width="34" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="文档" Click="OpenDocuments_Click">
                                        <Path Style="{StaticResource LineIconStyle}" Width="17" Height="17" Stroke="{DynamicResource TextMainBrush}" Data="M5,2 H12 L16,6 V18 H5 Z M12,2 V6 H16"/>
                                    </Button>
                                    <Button Width="34" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="下载" Click="OpenDownloads_Click">
                                        <Path Style="{StaticResource LineIconStyle}" Width="17" Height="17" Stroke="{DynamicResource TextMainBrush}" Data="M10,2 V13 M5.5,8.5 L10,13 L14.5,8.5 M3,16 H17"/>
                                    </Button>
                                    <Button Width="34" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="音乐" Click="OpenMusic_Click">
                                        <Path Style="{StaticResource LineIconStyle}" Width="17" Height="17" Stroke="{DynamicResource TextMainBrush}" Data="M8,4 V15 M8,15 A2.2,2.2 0 1 1 5.9,13.4 M8,4 L15,2.5 V13 M15,13 A2.2,2.2 0 1 1 12.9,11.4"/>
                                    </Button>
                                    <Button Width="34" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="图片" Click="OpenPictures_Click">
                                        <Path Style="{StaticResource LineIconStyle}" Width="17" Height="17" Stroke="{DynamicResource TextMainBrush}" Data="M2,3 H18 V17 H2 Z M5,14 L9,8 L12,12 L14,10 L17,14"/>
                                    </Button>
                                    <Button Width="34" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="设置" Click="OpenSettings_Click">
                                        <Path Style="{StaticResource LineIconStyle}" Width="17" Height="17" Stroke="{DynamicResource TextMainBrush}" Data="M10,5.5 A4.5,4.5 0 1 1 9.99,5.5 M10,1.5 V3.5 M10,16.5 V18.5 M1.5,10 H3.5 M16.5,10 H18.5 M4,4 L5.4,5.4 M14.6,14.6 L16,16 M16,4 L14.6,5.4 M5.4,14.6 L4,16"/>
                                    </Button>
                                    <Button Width="34" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="电源" Click="PowerButton_Click">
                                        <Path Style="{StaticResource LineIconStyle}" Width="17" Height="17" Stroke="{DynamicResource TextMainBrush}" Data="M10,2 V8.5 M5.5,5.5 A6.6,6.6 0 1 0 14.5,5.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>