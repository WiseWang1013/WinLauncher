<Window x:Class="WinLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLauncher" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#80000000"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#AAFFFFFF"/>
        <SolidColorBrush x:Key="MetroBgBrush" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="SearchBoxBgBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="SearchBoxFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonFgBrush" Color="#FFFFFF"/>
        <CornerRadius x:Key="TileCornerRadius">0</CornerRadius>

        <Style x:Key="SplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
        </Style>

        <Style x:Key="AppListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="{DynamicResource WindowBgBrush}" CornerRadius="8" BorderBrush="#55FFFFFF" BorderThickness="1" AllowDrop="True" DragOver="Window_DragOver">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="10,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnHamburger" Content="≡" FontSize="24" Width="40" Height="40" Background="Transparent"
                            Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" Click="ToggleSettingsMenu"/>
                    <TextBlock Text="开始" Foreground="{DynamicResource TextMainBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtTime" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="—" Style="{StaticResource WindowBtnStyle}" Click="Minimize_Click"/>
                    <Button x:Name="btnMaximize" Content="□" Style="{StaticResource WindowBtnStyle}" Click="Maximize_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowBtnStyle}" Click="CloseButton_Click"/>
                </StackPanel>

                <!-- 设置菜单 -->
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=btnHamburger}" Placement="Bottom" StaysOpen="False">
                    <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="6" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <TextBlock Text="系统模式" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <Button Content="Win10 动态磁贴" Width="160" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin10"/>
                            <Button Content="Win8 Metro 全屏" Width="160" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin8"/>
                            <Button Content="Win7 经典开始菜单" Width="160" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin7"/>
                            <Button Content="Win11 极简单窗格" Width="160" Style="{StaticResource MenuButtonStyle}" Click="SwitchToWin11"/>

                            <Separator Margin="0,10"/>

                            <!-- 主题风格 -->
                            <TextBlock Text="主题风格 (仅限Win10/11)" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="深色" Width="75" Style="{StaticResource MenuButtonStyle}" Margin="0,0,10,0" Click="SetDarkTheme_Click"/>
                                <Button Content="浅色" Width="75" Style="{StaticResource MenuButtonStyle}" Click="SetLightTheme_Click"/>
                            </StackPanel>

                            <!-- Win8 自定义背景色 -->
                            <TextBlock Text="Win8 背景色" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <WrapPanel Margin="5,0,0,10">
                                <Button Width="24" Height="24" Margin="0,0,5,0" Background="#0A0A0A" BorderThickness="0" Click="MetroBg_Click" Tag="#0A0A0A"/>
                                <Button Width="24" Height="24" Margin="0,0,5,0" Background="#004275" BorderThickness="0" Click="MetroBg_Click" Tag="#004275"/>
                                <Button Width="24" Height="24" Margin="0,0,5,0" Background="#3D2B56" BorderThickness="0" Click="MetroBg_Click" Tag="#3D2B56"/>
                                <Button Width="24" Height="24" Margin="0,0,5,0" Background="#1A3A1A" BorderThickness="0" Click="MetroBg_Click" Tag="#1A3A1A"/>
                                <Button Width="24" Height="24" Background="#5B1A1A" BorderThickness="0" Click="MetroBg_Click" Tag="#5B1A1A"/>
                            </WrapPanel>

                            <Separator Margin="0,10"/>
                            <TextBlock Text="已导入皮肤 (右键删除)" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <ItemsControl x:Name="skinListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding SkinName}" Width="160" Style="{StaticResource MenuButtonStyle}" Click="ApplySkin_Click" Tag="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="删除该皮肤" Click="DeleteSkin_Click" Tag="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ 导入皮肤 JSON" Width="160" Style="{StaticResource MenuButtonStyle}" Background="#0078D7" Foreground="White" Margin="0,5,0,0" Click="ImportSkin_Click"/>

                            <Separator Margin="0,10"/>
                            <TextBlock Text="配置管理" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Margin="5,0,0,5"/>
                            <Button Content="📁 导入旧配置" Width="160" Style="{StaticResource MenuButtonStyle}" Background="#28A745" Foreground="White" Click="ImportConfig_Click"/>
                            <Button Content="📤 导出当前配置" Width="160" Style="{StaticResource MenuButtonStyle}" Background="#17A2B8" Foreground="White" Click="ExportConfig_Click"/>
                            <Button Content="⚠️ 一键还原 (清空配置)" Width="160" Style="{StaticResource MenuButtonStyle}" Background="#DC3545" Foreground="White" Click="ResetConfig_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- 主体内容 -->
            <Grid x:Name="gridMainContent" Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="colLeftPanel" Width="320" MinWidth="200" MaxWidth="500"/>
                    <ColumnDefinition x:Name="colSplitter" Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧面板 (所有模式通用，放应用列表) -->
                <Border x:Name="pnlLeft" Grid.Column="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="0" AllowDrop="True" DragOver="Window_DragOver">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtSearch" Grid.Row="0" Grid.ColumnSpan="2" Height="32" Margin="10,10,10,5"
                                 Background="{DynamicResource SearchBoxBgBrush}" Foreground="{DynamicResource SearchBoxFgBrush}" 
                                 BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" TextChanged="SearchBox_TextChanged" ToolTip="搜索应用"/>

                        <ListBox x:Name="lstApps" Grid.Row="1" Grid.Column="0" ItemContainerStyle="{StaticResource AppListItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="5"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="LstApps_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LstApps_PreviewMouseMove"
                                 PreviewTouchDown="LstApps_PreviewTouchDown"
                                 PreviewTouchUp="LstApps_PreviewTouchUp"
                                 PreviewTouchMove="LstApps_PreviewTouchMove"
                                 MouseDoubleClick="LstApps_MouseDoubleClick">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Margin="10,10,0,5" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="固定到任务栏" Click="PinToTaskbar_Click"/>
                                                <MenuItem Header="打开文件所在位置" Click="OpenFileLocation_Click"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Hidden" Margin="0,10,0,10">
                            <ItemsControl x:Name="letterPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Height="18" Click="Letter_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 底部功能按钮组 (矢量图标，自适应黑白) -->
                        <StackPanel x:Name="pnlWin10Buttons" Grid.Row="2" Grid.ColumnSpan="2" Margin="5,10,5,10">
                            <Button Height="40" Background="Transparent" BorderThickness="0" Click="UserAccount_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <Grid Width="28" Height="28" Margin="0,0,10,0">
                                        <Ellipse x:Name="ellipseAvatarBg" Fill="#555"/>
                                        <Image x:Name="imgUserAvatar" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <TextBlock Text="当前用户" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="OpenDocuments_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="文档" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="OpenPictures_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="图片" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="OpenSettings_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="设置" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" BorderThickness="0" Click="PowerButton_Click" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="电源" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter x:Name="gridSplitter" Grid.Column="1" Style="{StaticResource SplitterStyle}"/>

                <!-- Win10 磁贴面板 -->
                <Border x:Name="pnlRight10" Grid.Column="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="0" AllowDrop="True" DragOver="Window_DragOver">
                    <ScrollViewer x:Name="scrollWin10" VerticalScrollBarVisibility="Auto" Padding="15" AllowDrop="True" DragOver="Window_DragOver">
                        <StackPanel AllowDrop="True" DragOver="Window_DragOver">
                            <TextBlock Text="固定到开始屏幕" Foreground="{DynamicResource TextMainBrush}" FontSize="16" FontWeight="SemiBold" Margin="5,0,0,10"/>
                            <StackPanel x:Name="tileContainerPanel">
                                <ItemsControl x:Name="tileGroupsControl" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10" AllowDrop="True" DragOver="Window_DragOver">
                                                <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="5,0,0,5" MouseLeftButtonDown="GroupTitle_MouseLeftButtonDown"/>
                                                <ItemsControl ItemsSource="{Binding Tiles}" Height="{Binding GroupHeight}" 
                                                              AllowDrop="True" DragOver="Window_DragOver" Drop="Group_Drop">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Background="Transparent" AllowDrop="True" DragOver="Window_DragOver"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding TileColor}" CornerRadius="{DynamicResource TileCornerRadius}" AllowDrop="True" DragOver="Window_DragOver">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="自定义颜色" Click="ChangeTileColor_Click"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="小图" Click="SetTileSizeSmall"/>
                                                                        <MenuItem Header="中图" Click="SetTileSizeMedium"/>
                                                                        <MenuItem Header="宽图" Click="SetTileSizeWide"/>
                                                                        <MenuItem Header="大图" Click="SetTileSizeLarge"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="取消固定" Click="UnpinTile"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Grid PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" PreviewMouseMove="Tile_PreviewMouseMove" 
                                                                      PreviewTouchDown="Tile_PreviewTouchDown" PreviewTouchUp="Tile_PreviewTouchUp" PreviewTouchMove="Tile_PreviewTouchMove" Background="Transparent">
                                                                    <Button Background="Transparent" BorderThickness="0" Click="TileClick">
                                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                                                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,0,5"/>
                                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="90" TextAlignment="Center" Foreground="White" FontSize="12"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="50" Margin="5,10" Background="Transparent" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="{DynamicResource TileCornerRadius}"
                                        AllowDrop="True" DragOver="Window_DragOver" Drop="NewGroup_Drop">
                                    <TextBlock Text="+ 拖拽到此处新建磁贴分组" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Win7 经典开始菜单面板 (直接去掉多余占位，只留右侧系统链接) -->
                <Border x:Name="pnlWin7" Grid.Column="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="0" Visibility="Collapsed">
                    <Border Padding="20" Background="Transparent">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="系统链接" Foreground="{DynamicResource TextMainBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenDocuments_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="文档" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenPictures_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="图片" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenMusic_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="音乐" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenComputer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="计算机" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="控制面板" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenDevices_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE749;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="设备和打印机" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenDefaultPrograms_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC50;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="默认程序" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Height="36" Background="Transparent" Foreground="{DynamicResource TextMainBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Click="OpenHelp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9CE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMainBrush}" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="帮助和支持" Foreground="{DynamicResource TextMainBrush}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Win11 单窗格面板 -->
                <Border x:Name="pnlWin11" Grid.Column="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="固定应用" Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="Bold" Margin="15,15,0,10"/>
                        <ScrollViewer Grid.Row="1" Padding="15">
                            <WrapPanel x:Name="win11AppsGrid" Background="Transparent" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Win8 Metro 全屏面板 -->
                <Border x:Name="pnlRight8" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource MetroBgBrush}" CornerRadius="0" Visibility="Collapsed" AllowDrop="True" DragOver="Window_DragOver">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,0,0">
                            <Button Background="Transparent" BorderThickness="0" Click="MetroUserMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="36" Height="36" Margin="0,0,15,0">
                                        <Ellipse x:Name="ellipseMetroAvatarBg" Fill="#555"/>
                                        <Image x:Name="imgMetroAvatar" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <TextBlock x:Name="txtMetroUserName" Text="管理员" Foreground="White" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ScrollViewer x:Name="scrollWin8" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="metroTileControl" Margin="40,20,20,40">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding TileColor}" CornerRadius="{DynamicResource TileCornerRadius}" Margin="4">
                                            <Button Background="Transparent" BorderThickness="0" Click="TileClick">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                                    <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="90" TextAlignment="Center" Foreground="White" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Button x:Name="btnDownArrow" Width="40" Height="40" Background="Transparent" BorderThickness="0" Click="ToggleAppsView">
                                <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="20"/>
                            </Button>
                        </StackPanel>
                        <Grid x:Name="pnlAllAppsView" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource MetroBgBrush}" Visibility="Collapsed" Margin="20,10,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Click="ToggleAppsView">
                                    <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="20"/>
                                </Button>
                                <TextBlock Text="所有应用" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="allAppsMetroControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="180" Height="60" Background="Transparent" BorderThickness="0" Click="TileClick" HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,15,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>